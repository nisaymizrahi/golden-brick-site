{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "golden-brick-construction",
    "public": ".",
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/staff",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/staff/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/staff/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/client",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/client/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/client/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/estimate",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/estimate/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/estimate/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/basement-finishing-philadelphia/index.html",
        "destination": "/basement-finishing-philadelphia/",
        "type": 301
      },
      {
        "source": "/bathroom-remodel-cost-philadelphia/index.html",
        "destination": "/bathroom-remodel-cost-philadelphia/",
        "type": 301
      },
      {
        "source": "/bucks-county-home-renovation-contractor/index.html",
        "destination": "/bucks-county-home-renovation-contractor/",
        "type": 301
      },
      {
        "source": "/delaware-county-home-renovation-contractor/index.html",
        "destination": "/delaware-county-home-renovation-contractor/",
        "type": 301
      },
      {
        "source": "/fix-and-flip-contractor-philadelphia/index.html",
        "destination": "/fix-and-flip-contractor-philadelphia/",
        "type": 301
      },
      {
        "source": "/full-home-renovation-cost-philadelphia/index.html",
        "destination": "/full-home-renovation-cost-philadelphia/",
        "type": 301
      },
      {
        "source": "/full-renovation-philadelphia/index.html",
        "destination": "/full-renovation-philadelphia/",
        "type": 301
      },
      {
        "source": "/home-additions-philadelphia/index.html",
        "destination": "/home-additions-philadelphia/",
        "type": 301
      },
      {
        "source": "/how-long-does-a-philadelphia-remodel-take/index.html",
        "destination": "/how-long-does-a-philadelphia-remodel-take/",
        "type": 301
      },
      {
        "source": "/investment-property-construction-due-diligence/index.html",
        "destination": "/investment-property-construction-due-diligence/",
        "type": 301
      },
      {
        "source": "/kitchen-remodel-cost-philadelphia/index.html",
        "destination": "/kitchen-remodel-cost-philadelphia/",
        "type": 301
      },
      {
        "source": "/main-line-home-renovation-contractor/index.html",
        "destination": "/main-line-home-renovation-contractor/",
        "type": 301
      },
      {
        "source": "/montgomery-county-home-renovation-contractor/index.html",
        "destination": "/montgomery-county-home-renovation-contractor/",
        "type": 301
      },
      {
        "source": "/multifamily-renovation-contractor-philadelphia/index.html",
        "destination": "/multifamily-renovation-contractor-philadelphia/",
        "type": 301
      },
      {
        "source": "/permits-for-philadelphia-home-renovations/index.html",
        "destination": "/permits-for-philadelphia-home-renovations/",
        "type": 301
      },
      {
        "source": "/philadelphia-home-remodeling-contractor/index.html",
        "destination": "/philadelphia-home-remodeling-contractor/",
        "type": 301
      },
      {
        "source": "/philadelphia-rowhome-renovation-guide/index.html",
        "destination": "/philadelphia-rowhome-renovation-guide/",
        "type": 301
      },
      {
        "source": "/rental-rehab-contractor-philadelphia/index.html",
        "destination": "/rental-rehab-contractor-philadelphia/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/client/**",
        "destination": "/client/index.html"
      },
      {
        "source": "/estimate/**",
        "destination": "/estimate/index.html"
      },
      {
        "source": "/api/public/lead-intake",
        "function": {
          "functionId": "publicLeadIntake",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/auth/sync-session",
        "function": {
          "functionId": "syncStaffSession",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/staff/lead-customer-link",
        "function": {
          "functionId": "syncLeadCustomerLink",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/staff/archive-record",
        "function": {
          "functionId": "clientPortalApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/staff/convert-lead",
        "function": {
          "functionId": "convertLeadToProject",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/staff/create-service-order",
        "function": {
          "functionId": "createServiceOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/staff/create-service-checkout",
        "function": {
          "functionId": "createServiceCheckout",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/staff/estimate-share",
        "function": {
          "functionId": "clientPortalApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/staff/estimate-draft",
        "function": {
          "functionId": "generateEstimateDraft",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/estimate-view",
        "function": {
          "functionId": "clientPortalApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/estimate-sign",
        "function": {
          "functionId": "clientPortalApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/agreement-document",
        "function": {
          "functionId": "clientPortalApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/stripe/webhook",
        "function": {
          "functionId": "stripeWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/client/**",
        "function": {
          "functionId": "clientPortalApi",
          "region": "us-central1"
        }
      }
    ],
    "ignore": [
      "firebase.json",
      ".gitignore",
      ".firebaserc",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/.firebase/**",
      ".playwright-cli/**",
      "**/.playwright-cli/**",
      "output/**",
      "**/output/**",
      ".DS_Store",
      "**/.DS_Store",
      "images/**/*.pdf",
      "images/projects/in-progress/**",
      "images/projects/completed/**",
      "images/projects/README.md",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
