# Firebase Function configuration template
# Copy to .env.<firebase-project-id> and replace the placeholders locally.
CRM_ADMIN_EMAILS=admin@example.com
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_DOMAIN/api/staff/google-calendar/callback

# Non-secret Firebase Function parameters
GOOGLE_BUSINESS_ACCOUNT_ID=YOUR_GOOGLE_BUSINESS_ACCOUNT_ID
GOOGLE_BUSINESS_LOCATION_ID=YOUR_GOOGLE_BUSINESS_LOCATION_ID
GOOGLE_BUSINESS_PROFILE_URL=https://www.google.com/maps/place/YOUR_VERIFIED_PROFILE

# Secret Manager value — placeholder only. Set this with:
# firebase functions:secrets:set GOOGLE_BUSINESS_OAUTH
GOOGLE_BUSINESS_OAUTH={"clientId":"YOUR_OAUTH_CLIENT_ID","clientSecret":"YOUR_OAUTH_CLIENT_SECRET","refreshToken":"YOUR_OAUTH_REFRESH_TOKEN"}
